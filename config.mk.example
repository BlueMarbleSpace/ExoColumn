# ExoColumn local build configuration
# =====================================
# Copy this file to config.mk and edit for your machine.
# config.mk is machine-specific and is NOT committed to version control.
#
# Usage:
#   cp config.mk.example config.mk
#   # edit config.mk, then:
#   cd build && make

# --- Fortran compiler ---------------------------------------------------------
# Default (no entry here): `ifx` as found on PATH.  For an Intel OneAPI build,
# `source /opt/intel/oneapi/setvars.sh` first so that ifx is on PATH.
# Set USER_FC to name a different compiler or an explicit path, e.g.:
#
# USER_FC = gfortran
# USER_FC = /opt/intel/oneapi/compiler/2025.3/bin/ifx
#
# The build selects compiler flags from USER_FC's basename, so any name
# containing "gfortran" gets the gfortran flags and everything else is treated
# as ifort-compatible.

# --- NetCDF-Fortran -----------------------------------------------------------
# Required when the system nf-config points to a NetCDF built with a different
# compiler (e.g. system NetCDF is gfortran-compiled but you are using ifx).
# Set NETCDF_ROOT to the installation prefix of a NetCDF-Fortran built with
# the same compiler as USER_FC / the default ifx.
#
# NETCDF_ROOT = /opt/netcdf

# --- ExoRT source root --------------------------------------------------------
# Default: /models/ExoRT  (set in the Makefile).
# Override if ExoRT is installed elsewhere on your machine.
# This also sets the runtime data path — sys_rootdir.F90 is generated from
# this value at build time so ExoRT never needs to be modified.
#
# EXORT_ROOT = /models/ExoRT

# --- Vertical levels ----------------------------------------------------------
# Number of vertical model layers (pver).  This is a compile-time constant in
# ExoRT (used to size static arrays), so it must be fixed at build time.  Set
# here in ExoColumn so /models/ExoRT remains untouched: the build generates
# src/exoplanet_mod.F90 from ExoRT's source with this value substituted in,
# and compiles the local copy instead.
# Default: 70 (pure log-spaced from p_top to ps).
# Recompile (make clean && make) after changing.
#
# PVER = 70

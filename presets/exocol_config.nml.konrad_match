! ============================================================================
! exocol_config.nml.konrad_match
!
! konrad apples-to-apples comparison preset.  Copy over exocol_config.nml to run:
!     cp exocol_config.nml.konrad_match exocol_config.nml
!     run/exocol.exe
!
! Purpose: strip out the thermodynamic differences between ExoColumn and konrad
! so the residual model-vs-model difference is dominated by radiative transfer
! (ExoRT-n68equiv vs RRTMG).  Two levers vs the production default:
!
!   1. latent_heat_mode = 'fixed_vap'
!        Uses a fixed liquid latent heat L_v at all temperatures (no sublimation
!        enhancement below 0 C), matching konrad's MoistLapseRate, which uses a
!        single heat_of_vaporization constant.  Removes the dominant (~1.8 K)
!        deep-troposphere warm bias.  (esat stays phase-aware in both models.)
!
!   2. Argon in the dry-air composition (ar_vmr = 0.00934)
!        Sets mwdry ~ 28.97 g/mol and cpdry ~ 1004 J/kg/K, matching konrad's
!        Rd (287.06) and cp (1004.64).  Already the production default; kept here
!        explicitly for clarity.
!
! Match the konrad reference generated by tools/generate_konrad_ref.py, which
! uses: 338.3 W/m2 insolation (coszrs=0.5), FixedRH 0.70, RCEMIP ozone,
! CO2=400 ppm, CH4=1.8 ppm, ColdPointCoupling stratosphere.
!
! NOTE: the albedo below is NOT re-calibrated for fixed_vap mode (fixed L_v makes
! the upper troposphere cooler, shifting Ts).  This preset is for the radiative
! comparison, not for Ts=288 calibration; re-tune the albedo if you need a
! specific surface temperature.
! ============================================================================
&exocol_nml
  conv_scheme      = 'sbm'
  tau_conv         = 3600.0
  rh_sbm           = 0.7         ! match konrad FixedRH(0.70)
  moisture_scheme  = 'prognostic'
  o3_profile       = 'rcemip'    ! match konrad RCEMIP ozone
  wind_speed       = 5.0
  C_D              = 1.5e-3
  msdist           = 1.0
  dz_slab          = 10.0
  n_sfc_layers     = 0
  dp_sfc_bot       = 200.0
  sfc_stretch      = 1.5
  latent_heat_mode = 'fixed_vap' ! <-- konrad-match: fixed L_v, no sublimation
/

&exocol_init
  input_file = ''
  ts         = 288.0
  t_strato   = 200.0
  p_top      = 100.0
  rh_init    =   0.7
  coszrs     =   0.5             ! 338.3 W/m2 TOA, matching konrad reference
  cpdry      = 1004.0
  asdir      =   0.2691          ! production calibration value (not re-tuned for fixed_vap)
  asdif      =   0.2691
  aldir      =   0.2691
  aldif      =   0.2691
/

&exocol_composition
  ps       = 1.0e5
  co2_vmr  = 4.0e-4              ! 400 ppm, matching konrad
  ch4_vmr  = 1.8e-6             ! 1.8 ppm, matching konrad
  n2_vmr   = 0.78084
  o2_vmr   = 0.20946
  ar_vmr   = 0.00934            ! argon: mwdry ~28.97, cpdry ~1004 (matches konrad)
  o3_vmr   = 1.0e-7
/
